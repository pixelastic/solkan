#!/usr/bin/env node

import minimist from 'minimist';
import { getCommandLineState } from '../lib/main.js';
import { rewriteCommandLine } from '../lib/rewriteCommandLine.js';
import { loadAllowList } from '../lib/loadAllowList.js';
import { loadRewriteMap } from '../lib/loadRewriteMap.js';

const args = minimist(process.argv.slice(2));

async function main() {
  const hasAllowList = args['allow-list'] || args['allow-list-file'];
  const hasRewriteList = args['rewrite-list-file'];

  // Require at least one feature flag
  if (!hasAllowList && !hasRewriteList) {
    console.error('Usage: solkan [--allow-list commands] [--allow-list-file file.json] <commandLine>');
    process.exit(2);
  }

  // Get the command line to validate (first positional argument)
  const commandLine = args._[0];

  if (!commandLine) {
    console.error('Usage: solkan [--allow-list commands] [--allow-list-file file.json] <commandLine>');
    process.exit(2);
  }

  const output = {};
  let isAllowed = true;
  let effectiveCommandLine = commandLine;

  // Load and apply rewrite map when flag is present
  if (hasRewriteList) {
    let rewriteMap;
    try {
      const paths = [].concat(args['rewrite-list-file']);
      rewriteMap = await loadRewriteMap(paths);
    } catch (error) {
      console.error(`Error reading rewrite-list file: ${error.message}`);
      process.exit(2);
    }

    const rewritten = rewriteCommandLine(commandLine, rewriteMap);
    if (rewritten !== commandLine) {
      output.rewrite = rewritten;
      effectiveCommandLine = rewritten;
    }
  }

  // Build allow output when allow-list flags are present
  if (hasAllowList) {
    let allowList = [];

    if (args['allow-list']) {
      // Inline comma-separated list
      allowList = args['allow-list'].split(',').map((s) => s.trim());
    } else if (args['allow-list-file']) {
      try {
        const paths = [].concat(args['allow-list-file']);
        allowList = await loadAllowList(paths);
      } catch (error) {
        console.error(`Error reading allow-list file: ${error.message}`);
        process.exit(2);
      }
    }

    const result = getCommandLineState(effectiveCommandLine, allowList);
    output.allow = {
      isAllowed: result.isAllowed,
      allowed: result.commands.allowed,
      rejected: result.commands.rejected,
    };
    isAllowed = result.isAllowed;
  }

  console.log(JSON.stringify(output));
  if (!isAllowed) process.exit(1);
  process.exit(0);
}

main();
