{
  "name": "solkan",
  "version": "0.11.0",
  "type": "module",
  "description": "CLI tool to validate a commandline against an allowlist of commands",
  "author": "pixelastic",
  "homepage": "https://github.com/pixelastic/solkan",
  "keywords": [
    "commands"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/pixelastic/solkan"
  },
  "sideEffects": false,
  "license": "MIT",
  "engines": {
    "node": ">=22.18.0"
  },
  "packageManager": "yarn@4.12.0",
  "files": [
    "./CHANGELOG.md",
    "./lib/*.js",
    "./lib/helpers/*.js"
  ],
  "exports": {
    ".": "./lib/main.js"
  },
  "main": "./lib/main.js",
  "bin": "./bin/solkan",
  "devDependencies": {
    "aberlaas": "2.35.0"
  },
  "dependencies": {
    "firost": "5.11.0",
    "golgoth": "4.0.0",
    "minimatch": "10.2.5",
    "minimist": "1.2.8",
    "unbash": "3.0.0"
  },
  "scripts": {
    "ci": "./scripts/ci",
    "compress": "./scripts/compress",
    "lint": "./scripts/lint",
    "lint:fix": "./scripts/lint-fix",
    "release": "./scripts/release",
    "test": "./scripts/test",
    "test:watch": "./scripts/test-watch"
  }
}
